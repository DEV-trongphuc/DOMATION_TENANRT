{
  "name": "auto-data-multi-tenant",
  "private": true,
  "version": "1.0.0",
  "description": "Auto Data Multi-Tenant (SaaS) Platform - Enterprise Lead Distribution, Dynamic CRM Pipeline, ZaloBot & Meta CAPI v21.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/index.ts",
    "cron": "tsx server/cron/master-cron.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "migrate:ecolife": "tsx scripts/migrate-ecolife-data.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "deploy:direct": "python scripts/deploy-direct.py",
    "deploy:direct:install": "python scripts/deploy-direct.py --install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.24.6",
    "pg": "^8.14.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.4.0",
    "tsx": "^4.19.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
