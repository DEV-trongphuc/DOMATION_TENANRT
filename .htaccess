# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/vhvxoigh/data.domation.net"
PassengerBaseURI "/"
PassengerNodejs "/opt/alt/alt-nodejs22/root/usr/bin/node"
PassengerAppType node
PassengerStartupFile app.cjs
PassengerAppEnv production
PassengerMinInstances 1
PassengerFriendlyErrorPages off
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Security hardening + Direct SPA static asset delivery
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct web access to private server files and embedded DB storage (allow public SPA /docs/api-v1)
  RewriteCond %{REQUEST_URI} !^/docs/api-v1(/|$)
  RewriteRule ^(\.env.*|\.autodata-pgdata|server|dist-server|tests|scripts|node_modules|docs|tsconfig\.server\.json|package(-lock)?\.json)(/|$) - [F,L]

  # Allow Let's Encrypt AutoSSL validation
  RewriteCond %{REQUEST_URI} ^/\.well-known/
  RewriteRule ^ - [L]

  # Serve built frontend files directly if they exist on disk (skipping API/v1)
  RewriteCond %{REQUEST_URI} !^/(api|v1)/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|.*\.log|package\.json|package-lock\.json|tsconfig.*\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
