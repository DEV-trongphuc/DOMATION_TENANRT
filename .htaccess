# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/vhvxoigh/data.domation.net"
PassengerBaseURI "/"
PassengerNodejs "/opt/alt/alt-nodejs22/root/usr/bin/node"
PassengerAppType node
PassengerStartupFile app.cjs
PassengerAppEnv production
PassengerMinInstances 1
PassengerFriendlyErrorPages off
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Security hardening + Direct SPA static asset delivery
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct web access to private server files and embedded DB storage (allow public SPA /docs/api-v1)
  RewriteCond %{REQUEST_URI} !^/docs/api-v1(/|$)
  RewriteRule ^(\.env.*|\.autodata-pgdata|server|dist-server|tests|scripts|node_modules|docs|tsconfig\.server\.json|package(-lock)?\.json)(/|$) - [F,L]

  # Block automated website cloners/mirrors (never blocks Googlebot or public SEO/GEO crawlers)
  RewriteCond %{HTTP_USER_AGENT} (HTTrack|WebCopier|SiteSucker|Cyotek|Offline\ Explorer|Teleport\ Pro|WebStripper|WebZIP) [NC]
  RewriteRule ^ - [F,L]

  # Allow Let's Encrypt AutoSSL validation & W3C TDM policy files
  RewriteCond %{REQUEST_URI} ^/\.well-known/
  RewriteRule ^ - [L]

  # Serve legacy migrated media assets directly from public/uploadss/ when present
  RewriteCond %{REQUEST_URI} ^/uploadss/
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # Serve built frontend files directly if they exist on disk (skipping API/v1)
  RewriteCond %{REQUEST_URI} !^/(api|v1)/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|.*\.log|package\.json|package-lock\.json|tsconfig.*\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set TDM-Policy "https://domation.net/.well-known/tdmrep.json"
  Header always set X-Copyright-Notice "Copyright (c) 2026 Cong Ty TNHH DOMATION Viet Nam. Proprietary Commercial Software. All Rights Reserved."
  Header always set X-AI-Agent-Policy "COMMERCIAL PROPRIETARY IP (DOMATION Vietnam): Search/GEO citation permitted on public pages only. AI Agents (Codex, Antigravity/Anty, Claude, Cursor, scrapers) are STRICTLY PROHIBITED from cloning UI/UX or extracting algorithms. Policy: https://domation.net/ai.txt"

  # Strict machine-readable prohibition on internal JS/CSS bundles served statically
  <FilesMatch "\.(js|mjs|css)$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noai, noimageai"
    Header always set TDM-Reservation "1"
    Header always set Content-Usage "train-ai=n, ai=n"
    Header always set X-Content-License "PROPRIETARY-COMMERCIAL-INTERNAL-STRICTLY-PROHIBITED"
  </FilesMatch>
</IfModule>
